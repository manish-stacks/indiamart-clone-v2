# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION - B2B + B2C MARKETPLACE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3001
APP_URL=http://localhost:3001
API_URL=http://localhost:4000

# Database Configuration (MySQL 8+ / MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/indiamart_marketplace"

# Redis Configuration (BullMQ, Socket.IO adapter, Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Authentication (Use cryptographically secure strings in production)
JWT_ACCESS_SECRET=development_jwt_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=development_jwt_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload & Media Storage
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
# S3 / MinIO Configuration (Optional when UPLOAD_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=marketplace-assets
AWS_ENDPOINT=

# Payment Gateway (Simulated / Razorpay development credentials)
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP Provider (Simulated / Msg91 / Twilio)
SMS_PROVIDER=simulated
SMS_API_KEY=

